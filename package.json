{
  "name": "ithaca-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:content": "node scripts/prepare-content.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "predev": "npm run prepare:content",
    "prebuild": "npm run prepare:content",
    "validate:content": "node scripts/validate-content.mjs",
    "new:edition": "node scripts/new-edition.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:starter": "node scripts/test-starter.mjs"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "entities": "^8.1.0",
    "marked": "^18.0.13",
    "sanitize-html": "^2.17.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "description": "A configurable reading edition for novels, epics and close-reading companions.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
